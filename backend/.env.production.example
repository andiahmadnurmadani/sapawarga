# ============================================================
# BACKEND — Production
# Salin ke .env dan isi dengan nilai yang benar saat deploy
# ============================================================

PORT=5678
NODE_ENV=production

# Database MySQL — sesuaikan dengan server production
DB_HOST=localhost
DB_PORT=3306
DB_USER=your_db_user
DB_PASSWORD=your_strong_db_password
DB_NAME=sapa_warga

# JWT — gunakan secret yang kuat dan unik! (min 32 karakter acak)
# Generate dengan: openssl rand -hex 64
JWT_SECRET=GANTI_DENGAN_SECRET_PANJANG_DAN_ACAK
JWT_EXPIRES_IN=7d

# CORS — hanya izinkan domain frontend production
FRONTEND_URL=https://your-frontend-domain.com

# CDN Kroombox
CDN_API_KEY=your_cdn_api_key_here
