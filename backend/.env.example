# ============================================================
# BACKEND — Environment Variables
# Salin file ini ke .env.development atau .env.production
# ============================================================

# Server
PORT=5000
# development | production
NODE_ENV=development

# Database MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=sapa_warga

# JWT
JWT_SECRET=ganti_dengan_string_acak_panjang_minimal_32_karakter
JWT_EXPIRES_IN=7d

# CORS — URL frontend yang diizinkan
# Development  : http://localhost:3000
# Production   : https://sapawarga.kii.lat
FRONTEND_URL=http://localhost:3000

# CDN Kroombox
CDN_API_KEY=your_cdn_api_key
