{
  "entities": {
    "HeroConfig": {
      "title": "Hero Configuration",
      "description": "Configuration for the hero section of the landing page",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "imageUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subtitle", "imageUrl"]
    },
    "VisionConfig": {
      "title": "Vision & Mission Configuration",
      "description": "Configuration for the vision and mission section",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "subtitle": { "type": "string" },
        "description": { "type": "string" },
        "imageUrl": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "subtitle", "description", "imageUrl"]
    },
    "GalleryItem": {
      "title": "Gallery Item",
      "description": "An item in the village gallery",
      "type": "object",
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "desc": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["url", "title", "desc"]
    },
    "Testimonial": {
      "title": "Testimonial",
      "description": "A testimonial from a resident",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "role": { "type": "string" },
        "quote": { "type": "string" },
        "avatarUrl": { "type": "string" },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "role", "quote"]
    }
  },
  "firestore": {
    "/site_config/hero": {
      "schema": "HeroConfig",
      "description": "Dynamic configuration for the Hero section"
    },
    "/site_config/vision": {
      "schema": "VisionConfig",
      "description": "Dynamic configuration for the Vision & Mission section"
    },
    "/gallery/{galleryId}": {
      "schema": "GalleryItem",
      "description": "Collection of gallery images"
    },
    "/testimonials/{testimonialId}": {
      "schema": "Testimonial",
      "description": "Collection of resident testimonials"
    }
  }
}
