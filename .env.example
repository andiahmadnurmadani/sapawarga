# ============================================================
# FRONTEND — Environment Variables
# Salin file ini ke .env.development atau .env.production
# ============================================================

# CDN Kroombox
VITE_CDN_API_KEY=your_cdn_api_key
VITE_CDN_JWT_TOKEN=your_cdn_jwt_token

# Backend API
# Development  : http://localhost:5000/api
# Production   : https://api-sapawarga.kolab.top/api
VITE_API_URL=http://localhost:5000/api

# Backend URL (untuk image proxy CDN)
# Development  : http://localhost:5000
# Production   : https://api-sapawarga.kolab.top
VITE_CDN_BACKEND_URL=http://localhost:5000
